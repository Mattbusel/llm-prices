{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2020"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "declaration": true,
    "sourceMap": false,
    "removeComments": false,
    "skipLibCheck": false,
    "rootDir": "src",
    "outDir": "dist/esm"
  },
  "include": ["src"]
}
