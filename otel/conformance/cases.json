{
 "description": "Shared conformance cases for the genaicost Collector processor (Go) and llm-prices-otel (Python). Each case is one span: its attributes before processing, the settings that differ from the defaults, and the attributes expected after it. Amounts are compared with a relative tolerance of 1e-12. PRICES_VERSION stands for the version of the llm-prices table in use. JSON integers are int attributes, numbers with a decimal point are double attributes. Cases with only=collector apply to the Collector processor alone. The Collector also runs every case with its default attributes: llm_prices, where the gen_ai.usage.cost.* names read llm_prices.cost.*.",
 "cases": [
  {
   "name": "semconv Anthropic span, input includes cache reads and writes",
   "attributes": {
    "gen_ai.provider.name": "anthropic",
    "gen_ai.operation.name": "chat",
    "gen_ai.request.model": "claude-sonnet-4-6",
    "gen_ai.usage.input_tokens": 50548,
    "gen_ai.usage.cache_read.input_tokens": 45000,
    "gen_ai.usage.cache_write.input_tokens": 3500,
    "gen_ai.usage.output_tokens": 1024
   },
   "expect": {
    "gen_ai.usage.cost.amount": 0.048129,
    "gen_ai.usage.cost.currency": "USD",
    "gen_ai.usage.cost.source": "local",
    "gen_ai.usage.cost.pricing.id": "llm-prices",
    "gen_ai.usage.cost.pricing.version": "PRICES_VERSION"
   }
  },
  {
   "name": "input reported without the cache counts (auto detects it)",
   "attributes": {
    "gen_ai.system": "Anthropic",
    "gen_ai.request.model": "claude-sonnet-4-6",
    "gen_ai.usage.input_tokens": 2048,
    "gen_ai.usage.cache_read_input_tokens": 45000,
    "gen_ai.usage.cache_creation_input_tokens": 3500,
    "gen_ai.usage.output_tokens": 1024
   },
   "expect": {
    "gen_ai.usage.cost.amount": 0.048129,
    "gen_ai.usage.cost.currency": "USD",
    "gen_ai.usage.cost.source": "local",
    "gen_ai.usage.cost.pricing.id": "llm-prices",
    "gen_ai.usage.cost.pricing.version": "PRICES_VERSION"
   }
  },
  {
