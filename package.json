{
  "name": "llm-prices",
  "version": "1.6.0",
  "private": true,
  "description": "Dated, source-cited LLM API prices (Anthropic, OpenAI, Gemini, DeepSeek, Mistral, xAI, Groq, Together, Fireworks, Cohere, Amazon Bedrock, OpenRouter, Perplexity) per 1M tokens, with provider-aware model-id lookup and exact decimal costs. Zero dependencies. Install from GitHub: npm i github:Mattbusel/llm-prices#v1",
  "keywords": [
    "llm",
    "pricing",
    "anthropic",
    "openai",
    "gemini",
    "tokens",
    "cost"
  ],
  "homepage": "https://github.com/Mattbusel/llm-prices/blob/main/docs/javascript.md",
  "bugs": "https://github.com/Mattbusel/llm-prices/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mattbusel/llm-prices.git"
  },
  "license": "MIT",
  "author": "Matthew Busel",
  "type": "module",
  "main": "./index.mjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./prices.json": "./prices.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "data.mjs",
    "data.d.mts",
    "prices.json",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}
